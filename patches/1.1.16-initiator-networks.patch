+/// Réseaux autorisés à demander une session (connexion ou relais), lus une fois dans la variable
+/// d'environnement INITIATOR_NETWORKS : liste de réseaux CIDR séparés par des virgules, par
+/// exemple « 100.64.0.0/10,fd7a:115c:a1e0::/48 » pour un tailnet Tailscale. Variable absente ou
+/// vide : aucune restriction, comme le serveur d'origine. Une entrée illisible arrête le
+/// programme, pour qu'une faute de frappe ne laisse pas le serveur ouvert à tous sans le dire.
+pub fn initiator_networks() -> &'static [ipnetwork::IpNetwork] {
+    static RESEAUX: OnceLock<Vec<ipnetwork::IpNetwork>> = OnceLock::new();
+    RESEAUX.get_or_init(|| {
+        let valeur = std::env::var("INITIATOR_NETWORKS").unwrap_or_default();
+        let mut reseaux = Vec::new();
+        for entree in valeur.split(',').map(str::trim).filter(|x| !x.is_empty()) {
+            match entree.parse::<ipnetwork::IpNetwork>() {
+                Ok(reseau) => reseaux.push(reseau),
+                Err(err) => {
+                    // log n'est pas toujours prêt ici : println, comme gen_sk.
+                    println!("Fatal error: invalid INITIATOR_NETWORKS entry {entree:?}: {err}");
+                    std::process::exit(1);
+                }
+            }
+        }
+        reseaux
+    })
+}
+
+/// Vrai si l'adresse peut demander une session : réseau autorisé, ou aucune restriction.
+/// À appeler avec l'adresse TCP réelle, jamais avec celle d'un en-tête X-Real-IP.
+pub fn initiator_allowed(addr: SocketAddr) -> bool {
+    let reseaux = initiator_networks();
+    if reseaux.is_empty() {
+        return true;
+    }
+    let ip = hbb_common::try_into_v4(addr).ip();
+    reseaux.iter().any(|reseau| reseau.contains(ip))
+}
